	if(strcmp(b, c) == 0){foreach(cp : EUDLoopPlayer('Human', None, None)){setcurpl(cp); DisplayText("\x13\x1B싱글플레이로는 플레이할 수 없습니다. 멀티플레이로 시작해주세요.\n\x13\x04실행 방지 코드 0x32223223 작동."); SetMemory(0xCDDDCDDC,SetTo,1);}}
	
	
	
