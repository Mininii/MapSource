// euddraft 불러오기 + Int64 epScript 사용 실험
import eudext.i64 as i64;
import eudext.epsmod as em;
import .helper as hp;
import ..shared.eudext.relmod as rm;
import localpy;

const A = i64.Int64(5);
const B = i64.Int64(0x100000000);
const Int64 = i64.Int64;

function onPluginStart() {
    const C = A + B;
    A.v += B;
    A.v -= 1;
    A.v = C;
    if (A < B) { DisplayText("lt"); }
    if (A >= 0x200000000 && A.lo == 5) { DisplayText("ge"); }
    if (!i64.sge32(dwread_epd(0), -5)) { DisplayText("sge32"); }
    const s = A.sge(B);
    const D = i64.add(A, 1);
    const E = Int64(3, 4);
    var lo, hi = D.lo, D.hi;
    const F = i64.wrap(lo, hi);
    em.hello();
    hp.helper_fn();
    rm.relfn();
    localpy.localfn();
    f_eprintln("A = ", A.fmt());
}
